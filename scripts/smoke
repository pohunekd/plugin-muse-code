#!/usr/bin/env bash
# End-to-end check of the Muse Code package against a pohunek build: links
# `package/` into an isolated daemon, launches the Muse release installed under
# --muse-dir and asserts status, input, trust and update behaviour.
#
# The daemon, its workers and Muse run in a network namespace that has only a
# loopback interface, with their own HOME and XDG roots below --root. No
# credential, no login and no real model is involved: the turns use Muse's own
# `--provider echo` or `scripts/model-stub` on the loopback with a placeholder
# key, and the approval dialog is only looked at, never answered.
#
#   scripts/smoke --root DIR --core-bin DIR --muse-dir DIR
#
#   --root      scratch directory for the isolated HOME (created, reused only
#               when it carries the marker this script writes)
#   --core-bin  directory with the pohunek, pohunekd and pohunek-sessiond
#               binaries of a core build that has the runtime features the
#               package requires
#   --muse-dir  directory of an installed Muse launcher (`muse`, `.muse-version`,
#               `muse-bin-<release>`); it is copied, never run in place
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(dirname "$SCRIPT_DIR")"

# Seconds each wait loop polls before it fails, and the poll interval.
WAIT_SECONDS=40
POLL_SECONDS=0.5
# Delay Muse's echo provider adds to a turn so `working` is observable.
ECHO_DELAY_MS=4000
PROMPT="smoke prompt"
# Loopback port of scripts/model-stub inside the namespace, and the placeholder
# key a profile hands to Muse there; neither reaches a real provider.
STUB_PORT=18083
PLACEHOLDER_KEY="smoke-placeholder-not-a-key"
# Initial-input acknowledgement window, and the poll interval and attempts used
# to catch the short `working` phase of a delayed echo turn.
INPUT_ACK_MS=8000
FAST_POLL_SECONDS=0.25
WORKING_POLLS=$((WAIT_SECONDS * 4))
# Bound on waiting for the daemon after teardown.
REAP_SECONDS=10
# Time a refused input gets to reach Muse before its effect is checked.
REFUSAL_SETTLE_SECONDS=2
# File the stub's scripted bash call writes in the workspace once approved;
# the redirect makes Muse ask for approval (a plain `touch` runs without it).
APPROVAL_MARKER="smoke-approved"
# Characters a path may hold where it becomes program text of the inner
# `bash -c` and part of a socat address (`:` and `,` separate socat options).
SAFE_PATH_RE='^[A-Za-z0-9._/+-]+$'

ROOT="" CORE_BIN="" MUSE_DIR=""
DAEMON_PID=""
NETNS=""

log() { printf 'smoke: %s\n' "$*" >&2; }
die() {
  log "FAIL: $*"
  exit 1
}
safe_path() { # <what> <path>
  [[ "$2" =~ $SAFE_PATH_RE ]] || die "$1 holds a character the namespace command cannot carry (allowed: letters, digits, . _ + - /): $2"
}

usage() {
  sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed '$d;s/^# \{0,1\}//' >&2
  exit 2
}

while (($# > 0)); do
  case "$1" in
    --root) ROOT="${2:?}"; shift 2 ;;
    --core-bin) CORE_BIN="${2:?}"; shift 2 ;;
    --muse-dir) MUSE_DIR="${2:?}"; shift 2 ;;
    -h | --help) usage ;;
    *) usage ;;
  esac
done
[[ -n "$ROOT" && -n "$CORE_BIN" && -n "$MUSE_DIR" ]] || usage
safe_path --root "$ROOT"
safe_path "the checkout path" "$REPO"

for tool in unshare ip jq sha256sum cp git readlink sed socat; do
  command -v "$tool" >/dev/null 2>&1 || die "missing tool: $tool"
done
unshare --help 2>&1 | grep -q -- '--map-user' || die "unshare lacks --map-user (util-linux 2.38 or later)"
for bin in pohunek pohunekd pohunek-sessiond; do
  [[ -x "$CORE_BIN/$bin" ]] || die "$CORE_BIN/$bin is not executable"
done
[[ -x "$MUSE_DIR/muse" && -f "$MUSE_DIR/.muse-version" ]] || die "$MUSE_DIR is not a Muse install"

MARKER=".muse-plugin-smoke-root"
mkdir -p "$ROOT"
ROOT="$(cd "$ROOT" && pwd -P)"
# A symlinked --root resolves to a path that needs the same check.
safe_path "the resolved --root" "$ROOT"
if [[ -n "$(ls -A "$ROOT")" && ! -e "$ROOT/$MARKER" ]]; then
  die "$ROOT is not empty and was not created by this script"
fi
touch "$ROOT/$MARKER"
# A socket path is bounded by sun_path; fail early with a clear message.
((${#ROOT} <= 60)) || die "--root is too long for the daemon socket path (${#ROOT} > 60)"

HOME_DIR="$ROOT/home"
RT_DIR="$ROOT/rt"
WS="$ROOT/ws"
rm -rf "$HOME_DIR" "$RT_DIR" "$WS" "$ROOT/stage" "$ROOT/daemon.log" "$ROOT/stub-state"
mkdir -p "$HOME_DIR/.local/bin" "$HOME_DIR/.config/pohunek/agents" "$HOME_DIR/.local/share" \
  "$HOME_DIR/.local/state" "$WS" "$ROOT/stage" "$ROOT/stub-state"
chmod 700 "$RT_DIR" 2>/dev/null || { mkdir -p "$RT_DIR" && chmod 700 "$RT_DIR"; }
chmod 700 "$HOME_DIR/.config/pohunek" "$HOME_DIR/.config/pohunek/agents"

# The release is copied once; its version file and launcher hash are compared
# after the run.
release="$(<"$MUSE_DIR/.muse-version")"
[[ "$release" == "$(<"$REPO/compat/RELEASE")" ]] || die "$MUSE_DIR holds Muse $release, compat/RELEASE locks $(<"$REPO/compat/RELEASE")"
for f in muse .muse-version .muse-release-info.json "muse-bin-$release"; do
  [[ -e "$MUSE_DIR/$f" ]] || die "$MUSE_DIR/$f is missing"
  cp --reflink=auto -a "$MUSE_DIR/$f" "$HOME_DIR/.local/bin/"
done
before_version="$(<"$HOME_DIR/.local/bin/.muse-version")"
before_launcher="$(sha256sum "$HOME_DIR/.local/bin/muse" | cut -d' ' -f1)"
install_listing() { find "$1" -mindepth 1 -printf '%P\n' | sort | tr '\n' ' '; }
before_files="$(install_listing "$HOME_DIR/.local/bin")"
git -C "$WS" init -q .
git -C "$WS" -c user.name=smoke -c user.email=smoke@example.invalid commit -q --allow-empty -m init

# Every command runs with a cleared environment, so nothing of the caller's
# POHUNEK_* or credential variables reaches the daemon or the CLI.
isolated() {
  env -i HOME="$HOME_DIR" XDG_CONFIG_HOME="$HOME_DIR/.config" XDG_DATA_HOME="$HOME_DIR/.local/share" \
    XDG_STATE_HOME="$HOME_DIR/.local/state" XDG_RUNTIME_DIR="$RT_DIR" \
    PATH="$HOME_DIR/.local/bin:/usr/bin:/bin" TERM=xterm-256color LANG=C.UTF-8 "$@"
}
pk() { isolated "$CORE_BIN/pohunek" "$@"; }

teardown() {
  local status=$?
  if [[ -n "$NETNS" ]]; then
    # Every process in the private namespace belongs to this run.
    local pid
    for pid in /proc/[0-9]*; do
      pid="${pid#/proc/}"
      [[ "$(readlink "/proc/$pid/ns/net" 2>/dev/null)" == "$NETNS" ]] || continue
      kill "$pid" 2>/dev/null || true
    done
  fi
  if [[ -n "$DAEMON_PID" ]]; then
    # Without a verified namespace only the job this script started is signalled.
    [[ -n "$NETNS" ]] || kill "$DAEMON_PID" 2>/dev/null || true
    local i
    for ((i = 0; i < REAP_SECONDS * 2; i++)); do
      kill -0 "$DAEMON_PID" 2>/dev/null || break
      sleep "$POLL_SECONDS"
    done
    kill -0 "$DAEMON_PID" 2>/dev/null && kill -9 "$DAEMON_PID" 2>/dev/null || true
    wait "$DAEMON_PID" 2>/dev/null || true
  fi
  if ((status == 0)); then
    log "PASS"
  else
    log "exit $status (daemon log: $ROOT/daemon.log)"
  fi
}
trap teardown EXIT

# --- daemon in a loopback-only namespace ---------------------------------
uid="$(id -u)" gid="$(id -g)"
# The inner scripts are quoted on purpose: each expands its own arguments. The
# model stub listens inside the namespace, so only its loopback reaches it.
# shellcheck disable=SC2016
unshare --user --map-root-user --net --mount bash -c '
  ip link set lo up
  exec unshare --user --map-user="$1" --map-group="$2" bash -c "
    STUB_STATE=$3 STUB_HOLD=3 STUB_TOOL_MARKER=STUB_TOOL STUB_ASK_MARKER=STUB_ASK STUB_TOOL_COMMAND=\"echo capture > $6\" \
      socat TCP-LISTEN:$5,bind=127.0.0.1,reuseaddr,fork EXEC:$4 &
    exec \"\$@\"" _ "${@:7}"
' _ "$uid" "$gid" "$ROOT/stub-state" "$REPO/scripts/model-stub" "$STUB_PORT" "$APPROVAL_MARKER" env -i HOME="$HOME_DIR" XDG_CONFIG_HOME="$HOME_DIR/.config" \
  XDG_DATA_HOME="$HOME_DIR/.local/share" XDG_STATE_HOME="$HOME_DIR/.local/state" \
  XDG_RUNTIME_DIR="$RT_DIR" PATH="$HOME_DIR/.local/bin:/usr/bin:/bin" TERM=xterm-256color \
  LANG=C.UTF-8 "$CORE_BIN/pohunek" daemon start --dev-subprocess >"$ROOT/daemon.log" 2>&1 &
DAEMON_PID=$!

wait_for() { # <description> <command...>
  local what="$1" i
  shift
  for ((i = 0; i < WAIT_SECONDS * 2; i++)); do
    if "$@" >/dev/null 2>&1; then return 0; fi
    sleep "$POLL_SECONDS"
  done
  die "timed out waiting for $what"
}
wait_for "the isolated daemon" pk health

# The CLI must reach the daemon of this root, not another one.
socket="$RT_DIR/pohunek/daemon.sock"
[[ -S "$socket" ]] || die "no daemon socket at $socket"
# `unshare` and `env` exec in place, so the background job is the daemon.
daemon_netns="$(readlink "/proc/$DAEMON_PID/ns/net")"
[[ -n "$daemon_netns" ]] || die "cannot find the daemon process"
[[ "$daemon_netns" != "$(readlink /proc/self/ns/net)" ]] || die "the daemon shares the host network namespace"
NETNS="$daemon_netns"
log "daemon is up in $NETNS (host: $(readlink /proc/self/ns/net))"

# --- package under a development id --------------------------------------
cp "$REPO/package/runtime.toml" "$REPO/package/detect.toml" "$ROOT/stage/"
sed -i 's/^id = "pohunek\.runtime\.muse"$/id = "dev.runtime.muse"/' "$ROOT/stage/runtime.toml"
grep -q '^id = "dev.runtime.muse"$' "$ROOT/stage/runtime.toml" || die "could not stage the development id"
pk plugin link "$ROOT/stage" --yes >/dev/null
digest="$(pk plugin list --json | jq -r '.ok.packages[0].digest')"
pk plugin enable dev.runtime.muse --digest "${digest#sha256:}" >/dev/null
pk plugin select dev.runtime.muse --digest "${digest#sha256:}" >/dev/null
pk plugin doctor | grep -q 'No problems found' || die "plugin doctor reports a problem"

# A profile replaces the descriptor's arguments, so it restates
# --trust-workspace and adds the credential-free provider.
cat >"$HOME_DIR/.config/pohunek/agents/muse-echo.toml" <<EOF
base = "muse"
package = "dev.runtime.muse"
digest = "$digest"
program = "muse"
args = ["--trust-workspace", "--provider", "echo", "--echo-delay-ms", "$ECHO_DELAY_MS"]
EOF
chmod 600 "$HOME_DIR/.config/pohunek/agents/muse-echo.toml"

activity_of() { pk session list --json | jq -r --arg n "$1" '.ok[] | select(.name == $n) | .activity // "none"'; }
session_id() { pk session list --json | jq -r --arg n "$1" '.ok[] | select(.name == $n) | .id'; }
muse_pid_of() { pk session list --json | jq -r --arg n "$1" '.ok[] | select(.name == $n) | .pid'; }
want_activity() { [[ "$(activity_of "$1")" == "$2" ]]; }
settled() { case "$(activity_of "$1")" in idle | blocked) return 0 ;; esac; return 1; }
native_of() { pk session list --json | jq -r --arg n "$1" '.ok[] | select(.name == $n) | .native_session_id // empty'; }

# --- 1. bare launch: trusted, composer drawn, resume keeps the flag -------
# Muse also reads its provider from `settings.json`, so the bare session runs
# the descriptor's own arguments with the credential-free provider.
muse_settings="$HOME_DIR/.config/muse/settings.json"
mkdir -p "$(dirname "$muse_settings")"
printf '%s\n' '{"schema_version":1,"provider":"echo"}' >"$muse_settings"
pk session new --agent muse --cwd "$WS" --name bare --yes >/dev/null
wait_for "the bare session to settle" settled bare
bare_id="$(session_id bare)"
pk session screen "$bare_id" | grep -q 'Do you trust this workspace?' && die "the bare session shows the trust dialog"
wait_for "the bare session to read idle" want_activity bare idle
bare_pid="$(muse_pid_of bare)"
args="$(tr '\0' ' ' <"/proc/$bare_pid/cmdline")"
[[ "$args" == *"muse-bin-"*" --trust-workspace "* ]] || die "unexpected launch arguments: $args"
tr '\0' '\n' <"/proc/$bare_pid/environ" | grep -qx 'MUSE_NO_AUTO_UPDATE=1' || die "MUSE_NO_AUTO_UPDATE=1 is not in the launch environment"
[[ "$(readlink "/proc/$bare_pid/ns/net")" == "$NETNS" ]] || die "Muse is not in the loopback-only namespace"
pk session input "$bare_id" "bare turn" >/dev/null
bare_reply() { pk session screen "$bare_id" | grep -q 'echo: bare turn'; }
wait_for "the bare reply on screen" bare_reply
bare_bound() { [[ -n "$(native_of bare)" ]]; }
wait_for "the SessionStart report to bind the bare session" bare_bound
pk session stop "$bare_id" >/dev/null
pk session resume "$bare_id" >/dev/null
wait_for "the resumed bare session to read idle" want_activity bare idle
bare_resumed="$(tr '\0' ' ' <"/proc/$(muse_pid_of bare)/cmdline")"
[[ "$bare_resumed" == *"muse-bin-"*" --trust-workspace -c managed_hooks_env_vars="*" resume $(native_of bare) " ]] ||
  die "unexpected bare resume arguments: $bare_resumed"
pk session stop "$bare_id" >/dev/null
rm "$muse_settings"
# `--trust-workspace` trusts the run only; Muse keeps no trust list for it.
[[ ! -e "$HOME_DIR/.config/muse/trust.json" ]] || die "the launch saved a trust decision"
log "bare launch: --trust-workspace on create and resume, no trust dialog, composer drawn, update flag set"
pk session stop "$(session_id bare)" >/dev/null

# --- 2. echo turn: composer ready, input accepted, working then idle ------
pk session new --agent muse-echo --cwd "$WS" --name echo --input "$PROMPT" \
  --input-ack-timeout-ms "$INPUT_ACK_MS" --yes --json >"$ROOT/echo-new.json"
[[ "$(jq -r '.ok.prompt_delivered' "$ROOT/echo-new.json")" == "true" ]] || die "the initial input did not start a turn"
echo_id="$(jq -r '.ok.id' "$ROOT/echo-new.json")"
reply_seen() { pk session screen "$echo_id" | grep -q "echo: $PROMPT"; }
wait_for "the echo reply on screen" reply_seen
wait_for "the echo session to read idle" want_activity echo idle
log "echo turn: input reached the composer, reply rendered, activity idle"

# A second turn proves the composer reads input after the first turn and that
# working is observed while the delayed echo runs.
pk session input "$echo_id" "second turn" >/dev/null
seen_working=""
for ((i = 0; i < WORKING_POLLS; i++)); do
  case "$(activity_of echo)" in
    working) seen_working=1; break ;;
  esac
  sleep "$FAST_POLL_SECONDS"
done
[[ -n "$seen_working" ]] || die "the second turn never read working"
second_seen() { pk session screen "$echo_id" | grep -q 'echo: second turn'; }
wait_for "the second reply on screen" second_seen
wait_for "the echo session to read idle again" want_activity echo idle
log "second turn: working observed, idle again"

# --- 2b. identity, reminder threads, resume -------------------------------
sessions_root="$HOME_DIR/.local/share/muse/sessions"
hook_trace="$HOME_DIR/.local/state/pohunek/logs/pohunek-hooks.jsonl"
bound() { [[ -n "$(native_of echo)" ]]; }
wait_for "the SessionStart report to bind the echo session" bound
echo_native="$(native_of echo)"
echo_log="$(find "$sessions_root" -mindepth 5 -maxdepth 5 -path "*/$echo_native/session.jsonl" -print -quit)"
[[ -n "$echo_log" ]] || die "no Muse session log for $echo_native"
reminders_seen() { grep -q '"reason":"reminder_thread"' "$hook_trace"; }
wait_for "the reminder threads to be filtered" reminders_seen
[[ "$(pk session list --json | jq -r '.ok[] | select(.name == "echo") | (.subagents // []) | length')" == 0 ]] ||
  die "a reminder thread became a subagent"
log "identity: bound to the Muse session, reminder threads filtered"
pk session stop "$echo_id" >/dev/null
pk session resume "$echo_id" >/dev/null
wait_for "the resumed session to read idle" want_activity echo idle
resumed_pid="$(muse_pid_of echo)"
resumed_args="$(tr '\0' ' ' <"/proc/$resumed_pid/cmdline")"
[[ "$resumed_args" == *"muse-bin-"*" --trust-workspace "*' -c managed_hooks_env_vars=["POHUNEK_ENV",'*'] resume '"$echo_native"' ' ]] ||
  die "unexpected resume arguments: $resumed_args"
[[ "$(readlink "/proc/$resumed_pid/cwd")" == "$WS" ]] || die "the resumed Muse runs outside the workspace"
# Names only: the values are the session's own and are never printed.
for name in TBH_MANAGED_HOOKS_PATH POHUNEK_SESSION_ID; do
  tr '\0' '\n' <"/proc/$resumed_pid/environ" | grep -q "^$name=" || die "$name is not in the resumed launch environment"
done
pk session input "$echo_id" "after resume" >/dev/null
after_resume() { pk session screen "$echo_id" | grep -q 'echo: after resume'; }
wait_for "the reply after resume" after_resume
wait_for "the echo session to read idle after resume" want_activity echo idle
[[ "$(native_of echo)" == "$echo_native" ]] || die "the resumed session changed its native reference"
log "resume: muse resume <id> in the workspace with the overlay and its environment, same reference"

# --- 3. the launcher never reached the update path ------------------------
bin="$HOME_DIR/.local/bin"
[[ ! -e "$bin/.muse-update-checked-at" ]] || die "the launcher recorded an update check"
[[ "$(<"$bin/.muse-version")" == "$before_version" ]] || die "the active release changed"
[[ "$(sha256sum "$bin/muse" | cut -d' ' -f1)" == "$before_launcher" ]] || die "the launcher script changed"
[[ "$(install_listing "$bin")" == "$before_files" ]] || die "files appeared in the install directory"
log "update: no check recorded, release $before_version unchanged"

pk session stop "$echo_id" >/dev/null

# --- 4. recovery needs the session log --------------------------------------
mv "$echo_log" "$echo_log.away"
refusal="$(pk session resume "$echo_id" --json || true)"
mv "$echo_log.away" "$echo_log"
[[ "$(jq -r '.err.code' <<<"$refusal")" == agent_native_reference_missing ]] ||
  die "resume without the session log was not refused: $refusal"
log "recovery: resume is refused while the session log is missing"

# --- 5. a profile key reaches Muse and nothing else ---------------------------
cat >"$HOME_DIR/.config/pohunek/agents/muse-stub.toml" <<EOF2
base = "muse"
package = "dev.runtime.muse"
digest = "$digest"
program = "muse"
args = ["--trust-workspace", "--provider", "meta", "--base-url", "http://127.0.0.1:$STUB_PORT"]
[env]
META_API_KEY = "$PLACEHOLDER_KEY"
EOF2
chmod 600 "$HOME_DIR/.config/pohunek/agents/muse-stub.toml"
pk session new --agent muse-stub --cwd "$WS" --name stub --input "stub hello" \
  --input-ack-timeout-ms "$INPUT_ACK_MS" --yes --json >"$ROOT/stub-new.json"
[[ "$(jq -r '.ok.prompt_delivered' "$ROOT/stub-new.json")" == "true" ]] || die "the stub turn did not start"
stub_id="$(session_id stub)"
stub_reply() { pk session screen "$stub_id" | grep -q 'stub reply'; }
wait_for "the stub reply" stub_reply
wait_for "the stub session to read idle" want_activity stub idle
log "profile key: the stub turn ran"

# --- 6. input is refused while the approval dialog shows -----------------------
# Enter on the dialog picks `Allow this stage once`, so input that reached it
# would run the stub's command unseen.
pk session input "$stub_id" "please STUB_TOOL" >/dev/null
approval_seen() { pk session screen "$stub_id" | grep -q 'Would you like to run the following command?'; }
wait_for "the approval dialog" approval_seen
wait_for "the stub session to read blocked" want_activity stub blocked
refusal="$(pk session input "$stub_id" "hello" --json || true)"
[[ "$(jq -r '.err.code' <<<"$refusal")" == session_input_blocked ]] || die "input reached the approval dialog: $refusal"
sleep "$REFUSAL_SETTLE_SECONDS"
[[ ! -e "$WS/$APPROVAL_MARKER" ]] || die "the command ran without the operator"
approval_seen || die "the approval dialog was answered without the operator"
log "approval: input refused, the command did not run, the dialog still shows"
pk session stop "$stub_id" >/dev/null
leaks="$(grep -rlF -- "$PLACEHOLDER_KEY" "$ROOT" | grep -vxF "$HOME_DIR/.config/pohunek/agents/muse-stub.toml" || true)"
[[ -z "$leaks" ]] || die "the profile key appears in: $leaks"
log "profile key: the key is in no file but the profile"
